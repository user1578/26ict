# 示例，不要填写真实密钥并提交到仓库
TRAVELGUARD_TOOL_API_KEY=replace-with-a-long-random-secret

# 高德Web服务Key，仅后端进程读取；为空时工具返回UNKNOWN
AMAP_API_KEY=

# 和风控制台API Host，仅域名，不含https://或路径
QWEATHER_API_HOST=
QWEATHER_API_KEY=

# 可选：由维护方提供的本地规则JSON。相对路径按启动目录解析。
# 未配置不载入data/，不编造地点规则。结构见docs/api_contract.md。
TRAVELGUARD_RULES_PATH=
